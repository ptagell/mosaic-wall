# Mosaic Wall configuration.
#
#   cp .env.example .env
#
# Only IMMICH_API_KEY has no default — everything else here is optional, and
# the values shown are what the code already falls back to.
#
# Most day-to-day settings (which scene, how often photos change, looks,
# effects, transitions, the sleep schedule) are controlled live in the admin
# UI and saved to data/registry.json. They are not configured here.
#
# A handful of extra timing and cache knobs exist for tuning; they are listed
# under "Advanced tuning" in the README and are best left alone.

# Immich API key. Immich web UI -> Account Settings -> API Keys.
# Read access is enough unless you use tap-to-favourite, which also needs
# album read/write.
IMMICH_API_KEY=

# Base URL of your Immich server, as reachable from where this runs (inside
# Docker that means a LAN address or service name, not 127.0.0.1).
#
#   - Include the port. Immich's default is 2283. Omit it and the request
#     goes to port 80, which only works behind a reverse proxy.
#   - HTTPS IS NOT SUPPORTED: the client uses Node's http module only, so an
#     https:// URL fails at startup with ERR_INVALID_PROTOCOL.
#
# Examples: http://192.168.1.10:2283   http://immich.lan:2283
IMMICH_URL=http://localhost:2283

# Port the frame server listens on. Tiles and admin are both served here.
PORT=4000

# Timezone for the schedule feature (sleep windows, timed scene changes).
# e.g. Australia/Melbourne, Europe/London, America/New_York
TZ=UTC

# Where the photo index and tile registry are written. Under Docker this is
# set to /app/data by docker-compose.yml and bind-mounted to ./data.
DATA_DIR=./data

# Album that tap-to-favourite adds to. Created on first use if missing.
FAVOURITES_ALBUM=Frame favourites

# Restrict the People scenes to specific Immich person IDs, comma-separated.
# Leave blank to offer everyone Immich has detected — usually what you want.
# Find an ID in the URL bar when you open a person in Immich.
PERSON_IDS=

# How far back the time-spread selection reaches, in years. Photos older than
# this never surface, so raise it if your library predates 2006 or so.
SMART_YEARS=20
